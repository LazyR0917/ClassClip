<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".TodoAddActivity">

    <!-- 顶栏：返回 + 标题 + 保存 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/course_action_cancel"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/brand_text_dark" />

        <TextView
            android:id="@+id/tv_todo_title_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/todo_add_title"
            android:textColor="@color/brand_text_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/course_action_save"
            android:textColor="@color/brand_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- 标题 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/todo_title_label"
                        android:textColor="@color/brand_text_dark"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/et_todo_title"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="center_vertical|end"
                        android:hint="@string/todo_title_hint"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/brand_text_dark"
                        android:textColorHint="@color/brand_text_gray"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke" />

                <!-- 备注 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/todo_note_label"
                        android:textColor="@color/brand_text_dark"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/et_todo_note"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:hint="@string/todo_note_hint"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:minHeight="32dp"
                        android:textColor="@color/brand_text_dark"
                        android:textColorHint="@color/brand_text_gray"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke" />

                <!-- 日期 -->
                <LinearLayout
                    android:id="@+id/row_todo_date"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/todo_date_label"
                        android:textColor="@color/brand_text_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_todo_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand_text_dark"
                        android:textSize="14sp"
                        tools:text="2026年10月25日 周日" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/todo_date_label"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/brand_text_gray" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke" />

                <!-- 时间（底部滚轮选择） -->
                <LinearLayout
                    android:id="@+id/row_todo_time"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/todo_time_label"
                        android:textColor="@color/brand_text_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_todo_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand_text_dark"
                        android:textSize="14sp"
                        tools:text="08:00" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/todo_time_label"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/brand_text_gray" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke" />

                <!-- 优先级（高/中/低，可不设置） -->
                <LinearLayout
                    android:id="@+id/row_todo_priority"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/todo_priority_label"
                        android:textColor="@color/brand_text_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_todo_priority"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand_text_dark"
                        android:textSize="14sp"
                        tools:text="中优先级" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/todo_priority_label"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/brand_text_gray" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke" />

                <!-- 四象限（重要/紧急 四选一，可不设置） -->
                <LinearLayout
                    android:id="@+id/row_todo_quadrant"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/todo_quadrant_label"
                        android:textColor="@color/brand_text_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_todo_quadrant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand_text_dark"
                        android:textSize="14sp"
                        tools:text="重要且紧急" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/todo_quadrant_label"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/brand_text_gray" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
