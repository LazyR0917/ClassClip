<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".PlanQuadrantActivity">

    <!-- 顶栏：返回 + 象限标题（带计数） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/course_action_cancel"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/tv_quadrant_detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/brand_text_dark"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="重要且紧急 · 3 项" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_quadrant_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:overScrollMode="never"
            android:padding="16dp" />

        <TextView
            android:id="@+id/tv_quadrant_detail_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/plan_quadrant_empty_all"
            android:textColor="@color/brand_text_gray"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
