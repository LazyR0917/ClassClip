<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/plan_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:context=".PlanFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- 顶部：标题 + 添加按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_plan_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plan_title"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_plan_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/plan_subtitle"
                    android:textColor="@color/brand_text_gray"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_add_plan"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_brand_light"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/brand_primary"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- 待办时间轴标题行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/plan_timeline_title"
                android:textColor="@color/brand_text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/plan_timeline_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plan_timeline_count"
                android:textColor="@color/brand_text_gray"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 时间轴卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="12dp">

            <HorizontalScrollView
                android:id="@+id/plan_days_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <!-- 时间轴容器：每个日期一列，列内 胶囊→节点→卡片 同宽同中心 -->
                <FrameLayout
                    android:id="@+id/plan_timeline_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </HorizontalScrollView>

            <!-- 回到今天：把时间轴滚回今天的节点 -->
            <TextView
                android:id="@+id/plan_back_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_light"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/plan_back_today"
                android:textColor="@color/brand_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 四象限待办标题行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/plan_quadrant_title"
                android:textColor="@color/brand_text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plan_quadrant_hint"
                android:textColor="@color/brand_text_gray"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 四象限 2x2：代码动态填充（Java 生成四个象限卡片容器） -->
        <LinearLayout
            android:id="@+id/plan_quadrant_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- 底部建议条 -->
        <TextView
            android:id="@+id/plan_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_white"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/brand_text_dark"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
