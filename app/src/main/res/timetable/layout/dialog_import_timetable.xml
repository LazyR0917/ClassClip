<?xml version="1.0" encoding="utf-8"?>
<!-- 导入课程表弹窗：粘贴文本 / 选择文件 两种方式 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/import_title"
        android:textColor="@color/brand_text_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/import_warning"
        android:textColor="@color/brand_danger"
        android:textSize="12sp" />

    <!-- 方式切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_import_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_selected"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="@string/import_tab_text"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tab_import_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_normal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="@string/import_tab_file"
            android:textColor="@color/brand_text_dark"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 粘贴文本区 -->
    <LinearLayout
        android:id="@+id/import_text_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/et_import_paste"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/bg_card_outline"
            android:gravity="top"
            android:hint="@string/import_paste_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="@color/brand_text_dark"
            android:textColorHint="@color/brand_text_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_parse_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_outline"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/import_parse"
            android:textColor="@color/brand_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 选择文件区 -->
    <LinearLayout
        android:id="@+id/import_file_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_pick_note"
            android:textColor="@color/brand_text_gray"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_pick_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_outline"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/import_pick_file"
            android:textColor="@color/brand_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 解析预览结果（限高可滚动，避免把按钮顶出屏幕） -->
    <ScrollView
        android:id="@+id/preview_scroll"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_import_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gray"
            android:lineSpacingExtra="3dp"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="@color/brand_text_dark"
            android:textSize="12sp" />
    </ScrollView>

    <!-- 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_import_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/import_cancel"
            android:textColor="@color/brand_text_gray"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_import_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:alpha="0.4"
            android:background="@drawable/bg_btn_check"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp"
            android:text="@string/import_confirm"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
