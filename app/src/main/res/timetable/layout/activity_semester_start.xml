<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".SemesterStartActivity">

    <!-- 顶栏：返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/scheme_cancel"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/brand_text_dark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="40dp"
            android:gravity="center"
            android:text="@string/semester_title"
            android:textColor="@color/brand_text_dark"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 顶部提示条 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hint_bar"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/semester_hint"
        android:textColor="@color/brand_primary"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 实时推算区 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/semester_compute_prefix"
                android:textColor="@color/brand_text_gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_week_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/semester_not_started"
                android:textColor="@color/brand_primary"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/semester_compute_hint"
                android:textColor="@color/brand_text_gray"
                android:textSize="12sp" />

            <!-- 日期选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/semester_pick_label"
                android:textColor="@color/brand_text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_white"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="10dp">

                <NumberPicker
                    android:id="@+id/picker_year"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:theme="?attr/dialogTheme" />

                <NumberPicker
                    android:id="@+id/picker_month"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:theme="?attr/dialogTheme" />

                <NumberPicker
                    android:id="@+id/picker_day"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:theme="?attr/dialogTheme" />
            </LinearLayout>

            <!-- 上课周数步进器 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:text="@string/semester_weeks_label"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_weeks_minus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_stepper_btn"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_weeks_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:gravity="center"
                    android:text="20"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_weeks_plus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_stepper_btn"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- 确认按钮 -->
            <TextView
                android:id="@+id/btn_confirm"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="@string/semester_confirm"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
