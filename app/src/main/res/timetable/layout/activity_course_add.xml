<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".CourseAddActivity">

    <!-- 顶栏：返回 + 标题 + 保存 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/course_action_cancel"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/brand_text_dark" />

        <TextView
            android:id="@+id/tv_page_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/course_add_title"
            android:textColor="@color/brand_text_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/course_action_save"
            android:textColor="@color/brand_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 学期信息提示条 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hint_bar"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tv_banner_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="当前为第 1 周 · 共 20 周" />

                <TextView
                    android:id="@+id/tv_banner_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/brand_text_gray"
                    android:textSize="12sp"
                    tools:text="在抽屉「开学日期」中设置后可自动计算周数" />
            </LinearLayout>

            <!-- 课程名称 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/course_name_label"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_course_name"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical|end"
                    android:hint="@string/course_name_hint2"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/brand_text_dark"
                    android:textColorHint="@color/brand_text_gray"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 时段卡片列表：每张卡 = 时段N + 课程周期/课程节数/教室地点/任课老师，由 Java 填充 -->
            <LinearLayout
                android:id="@+id/slot_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btn_add_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_light"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/course_add_more_time"
                android:textColor="@color/brand_primary"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
