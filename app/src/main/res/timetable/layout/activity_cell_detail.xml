<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".CellDetailActivity">

    <!-- 顶栏：返回 + 格子位置 + 新建 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/course_action_cancel"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/tv_cell_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/brand_text_dark"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="周四 · 第3-4节 · 10:00 - 11:40" />

        <TextView
            android:id="@+id/btn_cell_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_brand_light"
            android:gravity="center"
            android:text="@string/cell_dialog_add"
            android:textColor="@color/brand_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_cell_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:overScrollMode="never"
            android:padding="16dp" />

        <TextView
            android:id="@+id/tv_cell_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/cell_empty_hint"
            android:textColor="@color/brand_text_gray"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
