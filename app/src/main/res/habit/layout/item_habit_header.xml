<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".HabitFragment">

    <!-- 顶部：标题 + 添加按钮（三页统一浅色圆） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/habit_title"
                android:textColor="@color/brand_text_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_habit_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/habit_subtitle"
                android:textColor="@color/brand_text_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_add_habit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_brand_light"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/brand_primary"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- 进度卡：圆环 + 文案 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_progress_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_habit_ring"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:max="100"
                android:progress="50"
                app:indicatorColor="@color/brand_primary"
                app:indicatorInset="0dp"
                app:indicatorSize="64dp"
                app:trackColor="@color/progress_track"
                app:trackCornerRadius="3dp"
                app:trackThickness="6dp" />

            <TextView
                android:id="@+id/tv_habit_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="50%"
                android:textColor="@color/brand_text_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_habit_progress_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_habit_all"
                android:textColor="@color/brand_text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/habit_progress_msg"
                android:textColor="@color/brand_text_gray"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/habit_title"
            android:src="@drawable/ic_star"
            app:tint="@color/brand_primary" />
    </LinearLayout>

    <!-- 分类 chips（代码按分类表动态生成：全部 + 自定义分类），跟手滑动停稳即选中 -->
    <com.example.classclip.common.ChipsScrollView
        android:id="@+id/hs_habit_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_habit_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </com.example.classclip.common.ChipsScrollView>

    <!-- 自定义分类卡（点进管理页） -->
    <LinearLayout
        android:id="@+id/card_habit_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_brand_light" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/habit_category_title"
                android:src="@drawable/ic_label"
                app:tint="@color/brand_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/habit_category_title"
                android:textColor="@color/brand_text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/habit_category_subtitle"
                android:textColor="@color/brand_text_gray"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_dot"
            android:backgroundTint="@color/brand_primary" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_dot"
            android:backgroundTint="@color/course_purple_text" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_dot"
            android:backgroundTint="@color/course_orange_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/habit_category_manage"
            android:textColor="@color/brand_text_gray"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/habit_category_manage"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/brand_text_gray" />
    </LinearLayout>

    <!-- 分组标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/habit_section_title"
            android:textColor="@color/brand_text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_habit_week_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/habit_section_week"
            android:textColor="@color/brand_text_gray"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
